{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "derived_measure",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]+$"
    },
    "adjudication_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]+$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "code_revision": {
      "type": "string",
      "minLength": 1
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "adjudication_ids",
    "method",
    "code_revision",
    "value",
    "limitations"
  ],
  "additionalProperties": false
}

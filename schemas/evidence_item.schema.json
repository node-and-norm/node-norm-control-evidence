{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence_item",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]+$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]+$"
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_note": {
      "type": "string",
      "minLength": 1
    },
    "quality": {
      "type": "object",
      "properties": {
        "directness": {
          "type": "string",
          "minLength": 1
        },
        "independence": {
          "type": "string",
          "minLength": 1
        },
        "traceability": {
          "type": "string",
          "minLength": 1
        },
        "temporal_relevance": {
          "type": "string",
          "minLength": 1
        },
        "specificity": {
          "type": "string",
          "minLength": 1
        },
        "consistency": {
          "type": "string",
          "minLength": 1
        },
        "completeness": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "directness",
        "independence",
        "traceability",
        "temporal_relevance",
        "specificity",
        "consistency",
        "completeness"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "event_id",
    "source_id",
    "locator",
    "observation",
    "valid_from",
    "time_note",
    "quality"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "release",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "status": {
      "enum": [
        "development",
        "approved"
      ]
    },
    "approval_records": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "version",
    "schema_version",
    "status",
    "approval_records",
    "limitations"
  ],
  "additionalProperties": false
}

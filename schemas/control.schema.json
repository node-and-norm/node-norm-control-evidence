{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "control",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]+$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "opportunity": {
      "type": "string",
      "minLength": 1
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "preventive",
          "detective",
          "restrictive_corrective",
          "recovery",
          "authorization_governance",
          "human_oversight"
        ]
      }
    },
    "relevant_from": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "relevant_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "time_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "event_id",
    "objective",
    "opportunity",
    "functions",
    "relevant_from",
    "relevant_to",
    "time_note"
  ],
  "additionalProperties": false
}
